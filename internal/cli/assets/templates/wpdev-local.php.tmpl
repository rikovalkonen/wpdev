<?php
/** Plugin Name: wpdev local HTTPS trust (container only) */
if (!defined('ABSPATH') || getenv('WPDEV_LOCAL') !== '1') {
    return;
}
add_filter('http_request_args', static function ($args, $url) {
    $host = strtolower((string) parse_url($url, PHP_URL_HOST));
    $local_hosts = [{{range .Aliases}}{{phpquote .}},{{end}}];
    if (in_array($host, $local_hosts, true) && parse_url($url, PHP_URL_SCHEME) === 'https') {
        // Keep certificate and hostname verification enabled. Only use the
        // system bundle for this project's explicitly registered hostnames.
        $args['sslcertificates'] = '/etc/ssl/certs/ca-certificates.crt';
    }
    return $args;
}, 10, 2);
